---
// The email address at section-heading size, with a small "Copy address" button.
// The button is the only JavaScript on the site; without JavaScript it stays hidden
// and the mailto link still works.
import { EMAIL } from '../config';
---

<div class="copy-email">
  <a class="copy-email__address" href={`mailto:${EMAIL}`}>{EMAIL}</a>
  <button type="button" class="copy-email__button" data-email={EMAIL} hidden>
    <span data-label>Copy address</span>
  </button>
  <span class="visually-hidden" role="status" data-status></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-email__button')) {
    const label = button.querySelector<HTMLElement>('[data-label]');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-status]');
    const email = button.dataset.email ?? '';
    if (!label || !navigator.clipboard) continue;
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }
      label.textContent = 'Copied';
      if (status) status.textContent = 'Copied';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = 'Copy address';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .copy-email {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .copy-email__address {
    font-family: var(--font-sans);
    font-stretch: var(--heading-stretch);
    font-weight: var(--heading-weight);
    /* Section-heading size, unless the address would be wider than the screen
       (it is about 12.1 times its font size wide) */
    font-size: min(var(--size-section), (100vw - 2 * var(--margin)) / 12.4);
    line-height: 1.2;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-thickness: 1px;
  }

  @media (min-width: 1440px) {
    .copy-email__address {
      letter-spacing: -0.01em;
    }
  }

  .copy-email__button {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: var(--size-small);
    font-stretch: 100%;
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .copy-email__button:hover {
    color: var(--turmeric);
  }

  .copy-email__button[hidden] {
    display: none;
  }
</style>
