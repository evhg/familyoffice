---
import { COMPANY, EMAIL, LAUNCHED, LINKEDIN_ERIK, LINKEDIN_SUREKHA, YEAR } from '../config';
import Confirm from './Confirm.astro';
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__col">
      <p class="footer__wordmark">Verspui</p>
      <p>Verspui Family Office</p>
      <p>Phuket and Bangkok, Thailand</p>
      {
        COMPANY ? (
          <p>
            {COMPANY.name}, registration number {COMPANY.number}
          </p>
        ) : (
          !LAUNCHED && (
            <p>
              <Confirm>[CONFIRM: once the Thai holding company exists, add its registered name and registration number here.]</Confirm>
            </p>
          )
        )
      }
    </div>
    <ul role="list" class="footer__col">
      <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      {LINKEDIN_SUREKHA && <li><a href={LINKEDIN_SUREKHA}>Surekha on LinkedIn</a></li>}
      <li><a href={LINKEDIN_ERIK}>Erik on LinkedIn</a></li>
    </ul>
    <ul role="list" class="footer__col">
      <li><a href="/privacy/">Privacy</a></li>
      <li>© {YEAR} Verspui</li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(56px, 7vw, 96px) clamp(40px, 5vw, 72px);
    font-family: var(--font-sans);
    font-size: var(--size-small);
    font-stretch: 100%;
    line-height: 1.5;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px var(--gutter);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__col li,
  .footer__col p {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__wordmark {
    font-stretch: var(--wordmark-stretch);
    font-weight: var(--wordmark-weight);
    font-size: 1.25rem;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .footer__col:nth-child(1) {
      grid-column: 1 / 5;
    }

    .footer__col:nth-child(2) {
      grid-column: 5 / 9;
    }

    .footer__col:nth-child(3) {
      grid-column: 9 / 13;
    }
  }
</style>
