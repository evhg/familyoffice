---
// A single module on a Plaster surface: the face in Canopy, openings showing the surface.
import type { ModuleName } from './modules';

interface Props {
  name: ModuleName;
  size?: number;
  class?: string;
}

const { name, size = 56, class: className } = Astro.props;
---

<svg class:list={['tile', className]} width={size} height={size} aria-hidden="true" focusable="false">
  <use href={`#f-${name}`} width={size} height={size}></use>
</svg>

<style>
  .tile {
    display: block;
    flex: none;
    fill: var(--canopy);
  }
</style>
