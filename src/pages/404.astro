---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base title="This page doesn’t exist | Verspui" description="It may have moved.">
  <Header slot="header" />
  <article class="page wrap grid">
    <h1 class="h-section col-head">This page doesn’t exist</h1>
    <p class="col-body measure">It may have moved. <a class="tap" href="/">Go to the home page</a>.</p>
  </article>
</Base>

<style>
  .page {
    padding-block: clamp(48px, 8vw, 120px) clamp(96px, 12vw, 160px);
  }
</style>
